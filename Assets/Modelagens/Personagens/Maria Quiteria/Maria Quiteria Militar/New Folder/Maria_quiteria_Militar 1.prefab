--- !u!114 &9107052059557245314
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 268385782785989989}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: be3d2dec323ec614da1db0e59866c396, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  distanciaDoRaio: 4.46
  tempoEntreFalas: 10
  falasMissao:
  - "Que \xE9 isso que dizes, menina?! Tu est\xE1s louca? Mulher n\xE3o pega em armas!
    Isso \xE9 coisa de homem!"
  - "Cala a boca, Maria! N\xE3o digas mais essas doidices! Queres desonrar o nome
    da fam\xEDlia? Queres que te matem ou pior?"
  - "N\xE3o permito! Enquanto eu for vivo, nenhuma filha minha vai se meter em guerra.
    Fica em casa e esquece essa ideia de uma vez!"
  - "Basta! J\xE1 ouvi o suficiente dessa loucura! Vai agora mesmo para o teu quarto
    e n\xE3o saias dali at\xE9 eu mandar! E que n\xE3o me venhas mais com essas ideias
    de mulher guerreira, ouvi?"
  falasGenericas: []
  conversaAliado: 
  Manager1: {fileID: 0}
